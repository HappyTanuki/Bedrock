include_guard(GLOBAL)
function(_BedrockBuildConfig_enable_pch target)
    cmake_parse_arguments(ARG "" "HEADER" "" ${ARGN})
    if(NOT ARG_HEADER OR NOT IS_ABSOLUTE "${ARG_HEADER}")
        message(FATAL_ERROR "_BedrockBuildConfig_enable_pch requires an absolute HEADER path")
    endif()
    target_precompile_headers(${target} PRIVATE "${ARG_HEADER}")
endfunction()
function(_BedrockBuildConfig_set_msvc_runtime target)
    cmake_parse_arguments(ARG "" "VALUE" "" ${ARGN})
    if(NOT ARG_VALUE)
        message(FATAL_ERROR "_BedrockBuildConfig_set_msvc_runtime requires VALUE")
    endif()
    set_property(TARGET ${target} PROPERTY MSVC_RUNTIME_LIBRARY "${ARG_VALUE}")
endfunction()
function(_BedrockBuildConfig_set_msvc_debug_information target)
    if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        set_property(TARGET ${target} PROPERTY MSVC_DEBUG_INFORMATION_FORMAT "$<$<OR:$<CONFIG:Debug>,$<CONFIG:RelWithDebInfo>>:ProgramDatabase>")
    endif()
endfunction()
function(_BedrockBuildConfig_set_origin_rpath target)
    if(UNIX AND NOT APPLE AND CMAKE_BUILD_TYPE STREQUAL "Release")
        set_target_properties(${target} PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN" SKIP_BUILD_RPATH FALSE BUILD_RPATH "$ORIGIN")
    endif()
endfunction()
function(_BedrockBuildConfig_enable_windows_exports target)
    if(WIN32)
        set_property(TARGET ${target} PROPERTY WINDOWS_EXPORT_ALL_SYMBOLS ON)
    endif()
endfunction()
function(_BedrockBuildConfig_copy_runtime_dlls target)
    if(WIN32)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_RUNTIME_DLLS:${target}> $<TARGET_FILE_DIR:${target}>
            COMMAND_EXPAND_LISTS VERBATIM)
    endif()
endfunction()
