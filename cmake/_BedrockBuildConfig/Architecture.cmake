include_guard(GLOBAL)
function(_BedrockBuildConfig_detect_architecture)
    cmake_parse_arguments(ARG "" "OUT_PREFIX" "" ${ARGN})
    if(NOT ARG_OUT_PREFIX)
        message(FATAL_ERROR "_BedrockBuildConfig_detect_architecture requires OUT_PREFIX")
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _arch)
    set(_x86 0)
    set(_arm 0)
    if(_arch MATCHES "^(x86_64|amd64|x86|i[3-6]86)$")
        set(_x86 1)
        set(_name x86)
    elseif(_arch MATCHES "^(aarch64|arm64|armv[0-9].*|arm)$")
        set(_arm 1)
        set(_name arm)
    else()
        set(_name "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    set(${ARG_OUT_PREFIX}_ARCH_X86 ${_x86} PARENT_SCOPE)
    set(${ARG_OUT_PREFIX}_ARCH_ARM ${_arm} PARENT_SCOPE)
    set(${ARG_OUT_PREFIX}_ARCH_NAME "${_name}" PARENT_SCOPE)
endfunction()
