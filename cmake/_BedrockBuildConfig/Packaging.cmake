include_guard(GLOBAL)
function(_BedrockBuildConfig_register_package)
    cmake_parse_arguments(ARG "" "INSTALL_DESTINATION;EXPORT_NAME;NAMESPACE;CONFIG_FILE" "TARGETS" ${ARGN})
    if(NOT ARG_INSTALL_DESTINATION OR NOT ARG_EXPORT_NAME OR NOT ARG_NAMESPACE OR NOT ARG_CONFIG_FILE OR NOT ARG_TARGETS)
        message(FATAL_ERROR "_BedrockBuildConfig_register_package requires INSTALL_DESTINATION, EXPORT_NAME, NAMESPACE, CONFIG_FILE, TARGETS")
    endif()
    get_property(_registered GLOBAL PROPERTY _BEDROCK_BUILD_CONFIG_REGISTERED)
    if(_registered)
        return()
    endif()
    install(TARGETS ${ARG_TARGETS} EXPORT ${ARG_EXPORT_NAME})
    install(EXPORT ${ARG_EXPORT_NAME} NAMESPACE "${ARG_NAMESPACE}" DESTINATION "${ARG_INSTALL_DESTINATION}")
    configure_file("${ARG_CONFIG_FILE}" "${CMAKE_CURRENT_BINARY_DIR}/${ARG_EXPORT_NAME}Config.cmake" COPYONLY)
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/${ARG_EXPORT_NAME}Config.cmake" DESTINATION "${ARG_INSTALL_DESTINATION}")
    set_property(GLOBAL PROPERTY _BEDROCK_BUILD_CONFIG_REGISTERED TRUE)
endfunction()
