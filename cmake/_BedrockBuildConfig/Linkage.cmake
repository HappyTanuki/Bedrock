include_guard(GLOBAL)
include(CheckCXXSymbolExists)
function(_BedrockBuildConfig_detect_libc)
    cmake_parse_arguments(ARG "" "OUT_VAR" "" ${ARGN})
    if(NOT ARG_OUT_VAR)
        message(FATAL_ERROR "_BedrockBuildConfig_detect_libc requires OUT_VAR")
    endif()
    set(_libc unknown)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        if(CMAKE_CROSSCOMPILING)
            set(_libc unknown)
        else()
            check_cxx_symbol_exists(__GLIBC__ "features.h" _BEDROCK_HAS_GLIBC)
            if(_BEDROCK_HAS_GLIBC)
                set(_libc glibc)
            else()
                execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -dumpmachine OUTPUT_VARIABLE _triple OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
                if(_triple MATCHES "musl")
                    set(_libc musl)
                else()
                    file(GLOB _loaders "/lib/ld-musl-*.so*" "/lib64/ld-musl-*.so*")
                    if(_loaders)
                        set(_libc musl)
                    else()
                        set(_libc other)
                    endif()
                endif()
            endif()
        endif()
    endif()
    set(${ARG_OUT_VAR} "${_libc}" PARENT_SCOPE)
endfunction()
function(_BedrockBuildConfig_validate_linkage)
    cmake_parse_arguments(ARG "" "LIBRARY_TYPE;LIBC;LABEL" "" ${ARGN})
    if(NOT ARG_LIBRARY_TYPE OR NOT ARG_LIBC OR NOT ARG_LABEL)
        message(FATAL_ERROR "_BedrockBuildConfig_validate_linkage requires LIBRARY_TYPE, LIBC, LABEL")
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND ARG_LIBRARY_TYPE STREQUAL "STATIC" AND ARG_LIBC STREQUAL "glibc")
        message(FATAL_ERROR "${ARG_LABEL}: STATIC linkage is disallowed by this project's glibc redistribution policy; use BUILD_SHARED_LIBS=ON or a musl environment.")
    endif()
endfunction()
