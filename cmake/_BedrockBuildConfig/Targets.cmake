include_guard(GLOBAL)
function(_bedrock_build_config_target name)
    if(NOT TARGET _BedrockBuildConfig_${name})
        add_library(_BedrockBuildConfig_${name} INTERFACE)
        add_library(_BedrockBuildConfig::${name} ALIAS _BedrockBuildConfig_${name})
        set_target_properties(_BedrockBuildConfig_${name} PROPERTIES EXPORT_NAME ${name})
        set_property(GLOBAL APPEND PROPERTY _BEDROCK_BUILD_CONFIG_TARGETS _BedrockBuildConfig_${name})
    endif()
endfunction()
function(_BedrockBuildConfig_get_targets out_var)
    get_property(_targets GLOBAL PROPERTY _BEDROCK_BUILD_CONFIG_TARGETS)
    set(${out_var} "${_targets}" PARENT_SCOPE)
endfunction()

_bedrock_build_config_target(Cxx23)
target_compile_features(_BedrockBuildConfig_Cxx23 INTERFACE cxx_std_23)
