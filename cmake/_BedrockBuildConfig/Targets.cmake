    target_compile_options(_BedrockBuildConfig_Warnings INTERFACE /W4 /w14242 /w14254 /w14263 /w14265 /w14287 /we4289 /w14296 /w14311 /w14545 /w14546 /w14547 /w14549 /w14555 /w14619 /w14640 /w14826 /w14905 /w14906 /w14928)
    target_compile_options(_BedrockBuildConfig_WarningsAsErrors INTERFACE /WX)
    target_compile_options(_BedrockBuildConfig_MsvcParallel INTERFACE /MP)
    target_compile_options(_BedrockBuildConfig_Utf8 INTERFACE /utf-8)
    target_compile_options(_BedrockBuildConfig_MsvcConformance INTERFACE /permissive- /Zc:__cplusplus /Zc:preprocessor)
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(_BedrockBuildConfig_Warnings INTERFACE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wshadow -Wundef -Wunreachable-code -Wstrict-aliasing -Wnull-dereference -Wdouble-promotion -Wformat=2 -Wcast-qual -Wcast-align -Wuseless-cast)
