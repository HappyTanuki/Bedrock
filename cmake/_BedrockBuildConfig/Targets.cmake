function(_BedrockBuildConfig_set_language_properties target)
    set_target_properties(${target} PROPERTIES CXX_STANDARD 23 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)
endfunction()

function(_BedrockBuildConfig_configure_native_isa)
    option(BEDROCK_NATIVE_ISA "Enable native CPU instruction set" ON)
    set(BEDROCK_MSVC_ARCH "AVX2" CACHE STRING "MSVC /arch level (AVX512/AVX2/AVX or empty)")
    set(_flags "")
    if(BEDROCK_NATIVE_ISA)
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _cpu)
        if(_cpu MATCHES "^(x86_64|amd64|x86|i[3-6]86)$")
            if(MSVC)
                if(NOT BEDROCK_MSVC_ARCH STREQUAL "")
                    set(_flags "/arch:${BEDROCK_MSVC_ARCH}")
                endif()
            else()
                set(_flags "-march=native")
            endif()
        elseif(_cpu MATCHES "^(aarch64|arm64|armv[0-9].*|arm)$" AND NOT MSVC)
            set(_flags "-mcpu=native")
        endif()
    endif()
    if(_flags)
        target_compile_options(_BedrockBuildConfig_NativeIsa INTERFACE ${_flags})
    endif()
endfunction()
_BedrockBuildConfig_configure_native_isa()

# Report-only: clang-tidy must never rewrite sources during a build (parallel
# translation units race on shared headers and fetched sources would change).
find_program(_BEDROCK_CLANG_TIDY_EXE NAMES clang-tidy)
function(_BedrockBuildConfig_enable_clang_tidy target)
    if(_BEDROCK_CLANG_TIDY_EXE)
        set_property(TARGET ${target} PROPERTY CXX_CLANG_TIDY
            "${_BEDROCK_CLANG_TIDY_EXE};-checks=-*,google-readability-casting")
    endif()
endfunction()
