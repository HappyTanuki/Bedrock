    target_compile_options(_BedrockBuildConfig_Warnings INTERFACE -Weverything -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-unused-macros -Wno-padded -Wno-c++20-compat -Wno-exit-time-destructors -Wno-global-constructors -Wno-unsafe-buffer-usage -Wno-switch-default)
