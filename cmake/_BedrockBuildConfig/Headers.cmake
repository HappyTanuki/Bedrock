include_guard(GLOBAL)
function(_BedrockBuildConfig_stage_public_headers)
    cmake_parse_arguments(ARG "" "SOURCE_ROOT;DESTINATION;OUT_VAR" "FILES;TREES" ${ARGN})
    if(NOT ARG_SOURCE_ROOT OR NOT ARG_DESTINATION OR NOT ARG_OUT_VAR)
        message(FATAL_ERROR "_BedrockBuildConfig_stage_public_headers requires SOURCE_ROOT, DESTINATION, OUT_VAR")
    endif()
    file(REMOVE_RECURSE "${ARG_DESTINATION}")
    set(_paths ${ARG_FILES})
    foreach(_tree IN LISTS ARG_TREES)
        file(GLOB_RECURSE _tree_paths CONFIGURE_DEPENDS RELATIVE "${ARG_SOURCE_ROOT}" "${ARG_SOURCE_ROOT}/${_tree}/*")
        list(APPEND _paths ${_tree_paths})
    endforeach()
    foreach(_relative IN LISTS _paths)
        if(NOT EXISTS "${ARG_SOURCE_ROOT}/${_relative}")
            message(FATAL_ERROR "Public header does not exist: ${ARG_SOURCE_ROOT}/${_relative}")
        endif()
        get_filename_component(_dir "${_relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${ARG_DESTINATION}/${_dir}")
        configure_file("${ARG_SOURCE_ROOT}/${_relative}" "${ARG_DESTINATION}/${_relative}" COPYONLY)
    endforeach()
    set(${ARG_OUT_VAR} "${ARG_DESTINATION}" PARENT_SCOPE)
endfunction()
function(_BedrockBuildConfig_assert_header_visibility target)
    cmake_parse_arguments(ARG "" "SOURCE_ROOT" "" ${ARGN})
    if(NOT ARG_SOURCE_ROOT)
        message(FATAL_ERROR "_BedrockBuildConfig_assert_header_visibility requires SOURCE_ROOT")
    endif()
    get_target_property(_incs ${target} INTERFACE_INCLUDE_DIRECTORIES)
    if(ARG_SOURCE_ROOT IN_LIST _incs)
        message(FATAL_ERROR "${target} exposes its unfiltered source header root to consumers: ${ARG_SOURCE_ROOT}")
    endif()
endfunction()
